# ===================================================
# VARIABLES DE ENTORNO - BACKEND
# Copia este archivo como .env y completa los valores
# ===================================================

# Modo desarrollo
DEV_MODE=flase

# CORS - Orígenes permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173

# ===== SUPABASE =====
# Obtén estos valores en: https://app.supabase.com/project/TU_PROYECTO/settings/Data API / API Keys / JWT Keys

SUPABASE_URL=https://tu-proyecto.supabase.co copiar
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS...copiar
SUPABASE_JWT_SECRET=tu-jwt-secret-aqui
SUPABASE_SERVICE_ROLE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZS...copiar

# ===== JWT DE LA APLICACIÓN =====
# Estos valores deben coincidir con Supabase o puedes generar nuevos

APP_JWT_SECRET=tu-secret-key-para-jwtcopiar
APP_JWT_AUDIENCE=authenticated
APP_JWT_ISSUER=supabase

# ===== API =====
API_URL=http://localhost:8000
